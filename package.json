{
  "name": "kiro-fabric",
  "version": "0.65.0",
  "description": "Library API for Kiro Fabric; the native Kiro Agent ships as a self-installing release archive",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/chunks/*.js",
    "dist/runtime/compiler-worker-entry.js",
    "dist/runtime/sandbox-worker-entry.js",
    "dist/fovea/engine-entry.js",
    "dist/**/*.d.ts",
    "!dist/kiro-agent-closure/**/*",
    "docs/architecture.md",
    "docs/diagram-descriptions.md",
    "docs/images/execution-flow.svg",
    "docs/images/sessions-and-storage.svg",
    "docs/images/efficiency-flow.svg",
    "docs/images/approval-boundary.svg",
    "docs/images/output-flow.svg",
    "docs/images/runtime-topology.svg",
    "docs/images/checked-call-sequence.svg",
    "docs/images/navigator-evidence-flow.svg",
    "docs/images/edit-consistency-flow.svg",
    "docs/audit.md",
    "docs/configuration.md",
    "docs/installer.md",
    "docs/linux-validation.md",
    "docs/coding-readiness-2026-09-09.md",
    "docs/release.md",
    "docs/tracing.md",
    "README.md",
    "STATUS.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/generate-agent-guidance.mjs && node scripts/build.mjs && node scripts/build-kiro-closure.mjs && node scripts/normalize-artifact-modes.mjs && node scripts/assert-build-artifacts.mjs",
    "guidance:check": "node scripts/generate-agent-guidance.mjs --check",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.scripts.json",
    "audit:deps": "pnpm audit --audit-level moderate",
    "test": "node scripts/qualification-unavailable.mjs test-suite",
    "test:fast": "node scripts/qualification-unavailable.mjs test-fast-suite",
    "test:built": "node scripts/qualification-unavailable.mjs test-suite",
    "qualify:fovea:references": "node scripts/qualification-unavailable.mjs fovea-reference-qualification",
    "qualify:fovea:external": "node scripts/qualification-unavailable.mjs fovea-external-qualification",
    "qualify:fovea:controls": "node scripts/fovea-controls-probe.mjs",
    "qualify:fovea:human": "node scripts/fovea-human-qualification.mjs",
    "probe:continuity": "node scripts/continuity-acp-probe.mjs",
    "lint:dead": "knip",
    "verify:references": "node scripts/verify-project-references.mjs",
    "verify:offline": "node scripts/verify-offline.mjs",
    "verify:lifecycle": "node scripts/verify-offline.mjs lifecycle",
    "verify:remediation": "node scripts/verify-offline.mjs locking boundaries contracts",
    "efficiency:manifest": "node scripts/efficiency-baseline.mjs manifest",
    "efficiency:probe": "node scripts/efficiency-baseline.mjs probe",
    "agent:validate": "node scripts/validate-agent-package.mjs .tmp/kiro-fabric-agent",
    "agent:stage:local": "pnpm run build && node scripts/build-agent-dev.mjs",
    "agent:install": "bash ./install.sh --source --migrate-pi-fabric",
    "agent:update": "pnpm run agent:install",
    "agent:uninstall": "node scripts/install-manager.mjs uninstall",
    "agent:doctor": "node scripts/install-manager.mjs doctor",
    "agent:cache:gc": "node scripts/installer-cache.mjs",
    "agent:bundle": "pnpm run build && node scripts/build-complete-bundle.mjs && node scripts/generate-bundle-sbom.mjs",
    "sbom:bundle": "node scripts/generate-bundle-sbom.mjs",
    "certify": "pnpm run agent:stage:local && node scripts/certify-kiro-agent.mjs",
    "certify:agent": "pnpm run certify",
    "certify:agent:built": "node scripts/build-agent-dev.mjs && node scripts/certify-kiro-agent.mjs",
    "certify:agent:real": "node scripts/certify-kiro-agent-real.mjs",
    "sbom:agent": "node scripts/generate-agent-sbom.mjs --output .tmp/kiro-fabric-agent.spdx.json",
    "agent:archive": "node scripts/create-agent-archive.mjs --output .tmp/kiro-fabric-agent.tar.gz",
    "release:candidate": "pnpm run check && pnpm run agent:archive && node scripts/release-candidate-report.mjs",
    "release:complete:prepare": "node scripts/prepare-complete-release.mjs",
    "release:complete:signing-inputs": "node scripts/complete-release-signing-inputs.mjs",
    "release:complete:promote": "node scripts/complete-release-promotion.mjs",
    "release:complete:inputs": "node scripts/complete-release-inputs.mjs",
    "check:local": "node -e \"console.error(\u0027check:local: local-development verification only; NOT release qualification and NOT a substitute for the deleted behavioral suite.\u0027)\" && pnpm run guidance:check && pnpm run typecheck && pnpm run build && pnpm run lint:dead",
    "check": "pnpm run check:local && node scripts/qualification-unavailable.mjs release-grade-suite",
    "prepack": "pnpm run check"
  },
  "keywords": [
    "kiro",
    "agent",
    "mcp",
    "quickjs",
    "checked-typescript"
  ],
  "license": "MIT",
  "author": "monotykamary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asx8678/kiro-fabric.git"
  },
  "homepage": "https://github.com/asx8678/kiro-fabric#readme",
  "bugs": {
    "url": "https://github.com/asx8678/kiro-fabric/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "mcporter": "0.13.8",
    "quickjs-emscripten-core": "0.32.0",
    "typebox": "1.3.25",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "knip": "^6.34.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.20.0"
}
