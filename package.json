{
  "name": "kiro-fabric",
  "version": "0.63.0",
  "description": "A verified tool and Kiro ACP agent runtime",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js"
    },
    "./kiro": {
      "types": "./dist/kiro/index.d.ts",
      "import": "./dist/kiro/index.js"
    },
    "./verification": {
      "types": "./dist/verification/index.d.ts",
      "import": "./dist/verification/index.js"
    }
  },
  "bin": {
    "kiro-fabric": "./dist/kiro/cli-entry.js",
    "kiro-fabric-mcp": "./dist/kiro/mcp-entry.js",
    "kiro-fabric-setup": "./dist/kiro/setup-entry.js"
  },
  "files": [
    "dist/index.js",
    "dist/protocol.js",
    "dist/kernel/index.js",
    "dist/kiro/index.js",
    "dist/kiro/mcp-entry.js",
    "dist/kiro/agent-worker-entry.js",
    "dist/kiro/cli-entry.js",
    "dist/kiro/setup-entry.js",
    "dist/verification/index.js",
    "dist/chunks/*.js",
    "dist/kiro-closure/**/*",
    "dist/index.d.ts",
    "dist/protocol.d.ts",
    "dist/config.d.ts",
    "dist/thinking.d.ts",
    "dist/agents/runners.d.ts",
    "dist/components/model-guidance.d.ts",
    "dist/components/types.d.ts",
    "dist/core/evidence-ledger.d.ts",
    "dist/core/outcome-gate.d.ts",
    "dist/core/session-approvals.d.ts",
    "dist/runtime/source-limit.d.ts",
    "dist/prewalk/gate.d.ts",
    "dist/ui/code-preview.d.ts",
    "dist/kernel/index.d.ts",
    "dist/kernel/fabric-exec-contract.d.ts",
    "dist/kiro/agent-worker-options.d.ts",
    "dist/kiro/artifacts.d.ts",
    "dist/kiro/claims.d.ts",
    "dist/kiro/diagnostics.d.ts",
    "dist/kiro/doctor.d.ts",
    "dist/kiro/handoff.d.ts",
    "dist/kiro/home.d.ts",
    "dist/kiro/host.d.ts",
    "dist/kiro/index.d.ts",
    "dist/kiro/install.d.ts",
    "dist/kiro/managed.d.ts",
    "dist/kiro/mcp-server.d.ts",
    "dist/kiro/memory.d.ts",
    "dist/kiro/profile.d.ts",
    "dist/kiro/projection.d.ts",
    "dist/kiro/run-scope.d.ts",
    "dist/kiro/runtime-closure.d.ts",
    "dist/kiro/runtime.d.ts",
    "dist/kiro/skills.d.ts",
    "dist/kiro/topology.d.ts",
    "dist/kiro/uninstall.d.ts",
    "dist/kiro/v3-session.d.ts",
    "dist/verification/adapters.d.ts",
    "dist/verification/fingerprint.d.ts",
    "dist/verification/index.d.ts",
    "dist/verification/schemas.d.ts",
    "dist/verification/security-replay.d.ts",
    "dist/verification/types.d.ts",
    "skills/",
    "docs/security-replay.md",
    "docs/skills.md",
    "docs/kiro/installer.md",
    "docs/kiro/parity-qualification.md",
    "docs/kiro/capabilities-2.19.1.md",
    "docs/kiro/capabilities-2.20.1-v3.md",
    "docs/kiro/release-a.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/prune-dist-declarations.mjs && node scripts/build.mjs && node scripts/build-kiro-closure.mjs && node scripts/certify-closure-size.mjs && pnpm run assert:build-artifacts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:parallel && pnpm run test:process",
    "test:parallel": "vitest run --config vitest.config.ts",
    "test:process": "vitest run --config vitest.process.config.ts",
    "lint:dead": "knip --no-gitignore",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run lint:dead",
    "assert:build-artifacts": "node scripts/assert-build-artifacts.mjs",
    "bench:verify-verifiers": "python3 bench/mutation_verifiers.py --report bench/.artifacts/verifier-mutation-report.json",
    "replay:security": "pnpm run build && node scripts/run-security-replay.mjs",
    "certify:release-a": "node scripts/certify-release-a.mjs",
    "certify:kiro-claims": "node scripts/certify-kiro-claims.mjs",
    "refresh:kiro-readiness": "node scripts/refresh-kiro-readiness.mjs",
    "certify:release-a:real": "node scripts/certify-release-a-real.mjs",
    "certify:release-b:real": "node scripts/certify-release-b-real.mjs",
    "certify:release-d:real": "node scripts/certify-release-d-real.mjs",
    "rehearse:release-c": "node scripts/rehearse-release-crash.mjs",
    "prepack": "pnpm run check"
  },
  "keywords": [
    "kiro-fabric",
    "kiro",
    "codemode",
    "mcp",
    "agents",
    "verification",
    "workflows"
  ],
  "license": "MIT",
  "author": "monotykamary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asx8678/kiro-fabric.git"
  },
  "homepage": "https://github.com/asx8678/kiro-fabric#readme",
  "bugs": {
    "url": "https://github.com/asx8678/kiro-fabric/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-mjs-release-sync": "^0.32.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@shikijs/themes": "4.3.1",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "ignore": "^7.0.5",
    "mcporter": "^0.12.3",
    "minimatch": "^10.2.5",
    "quickjs-emscripten-core": "^0.32.0",
    "shiki": "^4.3.1",
    "typebox": "1.3.8",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.1.2",
    "esbuild": "^0.25.12",
    "knip": "^6.29.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
