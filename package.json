{
  "name": "kiro-fabric",
  "version": "0.64.0",
  "description": "A bounded checked-TypeScript workflow Power for Kiro CLI v3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/chunks/*.js",
    "dist/runtime/compiler-worker-entry.js",
    "dist/**/*.d.ts",
    "dist/kiro-power-closure/**/*",
    "plugin.json",
    "mcp.json",
    "power-product.json",
    "skills/fabric-exec/**/*",
    "docs/architecture.md",
    "docs/audit.md",
    "docs/configuration.md",
    "docs/release.md",
    "README.md",
    "STATUS.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-kiro-closure.mjs && node scripts/assert-build-artifacts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-power-dev.mjs && vitest run",
    "lint:dead": "knip",
    "power:validate": "node scripts/validate-power-package.mjs .tmp/kiro-fabric-power",
    "power:stage": "pnpm run build && node scripts/build-power-dev.mjs",
    "power:dev": "pnpm run power:stage",
    "power:export:user": "pnpm run power:stage && node scripts/power-user-install.mjs .tmp/kiro-fabric-power",
    "certify": "pnpm run power:stage && node scripts/certify-kiro-power.mjs",
    "certify:power": "pnpm run certify",
    "certify:power:built": "node scripts/build-power-dev.mjs && node scripts/certify-kiro-power.mjs",
    "certify:power:real": "node scripts/certify-kiro-power-real.mjs",
    "sbom:power": "node scripts/generate-power-sbom.mjs --output .tmp/kiro-fabric-power.spdx.json",
    "release:candidate": "pnpm run check && node scripts/release-candidate-report.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run lint:dead && node scripts/build-power-dev.mjs && node scripts/certify-kiro-power.mjs && pnpm run sbom:power",
    "prepack": "pnpm run check"
  },
  "keywords": [
    "kiro",
    "power",
    "mcp",
    "quickjs",
    "checked-typescript"
  ],
  "license": "MIT",
  "author": "monotykamary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asx8678/kiro-fabric.git"
  },
  "homepage": "https://github.com/asx8678/kiro-fabric#readme",
  "bugs": {
    "url": "https://github.com/asx8678/kiro-fabric/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "mcporter": "0.12.3",
    "quickjs-emscripten-core": "0.32.0",
    "typebox": "1.3.8",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.25.12",
    "knip": "^6.29.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
