{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fabric": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "kiro-fabric@0.63.0",
        "mcp",
        "--integration",
        "power"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "KIRO_FABRIC_INTEGRATION": "power"
      }
    }
  }
}
