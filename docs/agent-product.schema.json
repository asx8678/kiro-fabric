{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asx8678/kiro-fabric/blob/main/docs/agent-product.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "entrypoint", "outputBundle", "runtimeAssets", "tools", "mountedProviders", "bundledAgentResources", "allowedPackageDependencies", "forbiddenRuntimeModules"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "product": { "const": "kiro-fabric-agent" },
    "entrypoint": { "const": "src/kiro/mcp-entry.ts" },
    "outputBundle": { "const": "dist/kiro-agent-closure" },
    "runtimeAssets": { "type": "object", "additionalProperties": false, "required": ["compilerWorker"], "properties": { "compilerWorker": { "const": "src/runtime/compiler-worker-entry.ts" } } },
    "tools": { "const": ["fabric_info", "fabric_workspace", "fabric_exec"] },
    "mountedProviders": { "const": ["artifacts", "memory", "state", "mcp"] },
    "bundledAgentResources": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "allowedPackageDependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "forbiddenRuntimeModules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
