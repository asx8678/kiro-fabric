{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "entrypoint",
    "runtimeAssets",
    "mountedProviders",
    "allowedPackageDependencies",
    "forbiddenRuntimeModules"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "product": { "const": "kiro-fabric-power" },
    "entrypoint": { "const": "src/kiro/mcp-entry.ts" },
    "runtimeAssets": {
      "type": "object",
      "required": ["compilerWorker"],
      "properties": {
        "compilerWorker": { "const": "src/runtime/compiler-worker-entry.ts" }
      },
      "additionalProperties": false
    },
    "mountedProviders": {
      "type": "array",
      "items": { "enum": ["artifacts", "memory", "state", "mcp"] },
      "uniqueItems": true
    },
    "allowedPackageDependencies": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "forbiddenRuntimeModules": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
